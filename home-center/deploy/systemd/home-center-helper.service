[Unit]
Description=Home Center bounded privileged helper
After=local-fs.target
Before=home-center.service

[Service]
Type=simple
User=root
Group=home-center
ExecStart=/usr/bin/python3 /opt/home-center/current/home_center/privileged_helper_v2.py --serve
Restart=on-failure
RestartSec=2s
RuntimeDirectory=home-center-helper
RuntimeDirectoryMode=0750
StateDirectory=home-center-helper
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/etc/home-center/pki/web
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=192.168.10.253/32
IPAddressAllow=192.168.10.254/32
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
