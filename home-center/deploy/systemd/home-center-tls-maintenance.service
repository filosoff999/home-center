[Unit]
Description=Home Center Web TLS maintenance check
Requires=home-center-helper.service
After=home-center-helper.service local-fs.target

[Service]
Type=oneshot
User=home-center
Group=home-center
ExecStart=/usr/bin/python3 /opt/home-center/current/home_center/tls_maintenance.py
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/home-center
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
SystemCallArchitectures=native
