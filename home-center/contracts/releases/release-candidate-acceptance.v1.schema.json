{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.invalid/contracts/releases/release-candidate-acceptance.v1.schema.json",
  "title": "Home Center 0.9 release-candidate acceptance evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "acceptance_id",
    "candidate",
    "predecessor",
    "rollout",
    "rollback_drill",
    "cluster",
    "external_access",
    "safety"
  ],
  "properties": {
    "schema": {"const": "home-center.release-candidate-acceptance.v1"},
    "acceptance_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
    "candidate": {"$ref": "#/$defs/candidateIdentity"},
    "predecessor": {"$ref": "#/$defs/predecessorIdentity"},
    "rollout": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/dc02Rollout"},
        {"$ref": "#/$defs/dc01Rollout"}
      ],
      "items": false
    },
    "rollback_drill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "order", "restored_nodes", "state_restore", "audit_chain", "backups_reverified"],
      "properties": {
        "status": {"const": "passed"},
        "order": {"const": ["dc01", "dc02"]},
        "restored_nodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {"$ref": "#/$defs/dc01Restore"},
            {"$ref": "#/$defs/dc02Restore"}
          ],
          "items": false
        },
        "state_restore": {"const": "passed"},
        "audit_chain": {"const": "passed"},
        "backups_reverified": {"const": "passed"}
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_dns_name",
        "domain_sid",
        "nodes",
        "writer_count",
        "automatic_failover",
        "version_parity",
        "revision_parity",
        "artifact_parity",
        "drs_replication",
        "peer_mtls"
      ],
      "properties": {
        "domain_dns_name": {"const": "hm.dm"},
        "domain_sid": {"const": "S-1-5-21-483832520-828804035-215000592"},
        "nodes": {"const": ["dc01", "dc02"]},
        "writer_count": {"const": 1},
        "automatic_failover": {"const": false},
        "version_parity": {"const": "passed"},
        "revision_parity": {"const": "passed"},
        "artifact_parity": {"const": "passed"},
        "drs_replication": {"const": "passed"},
        "peer_mtls": {"const": "passed"}
      }
    },
    "external_access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_default_disabled",
        "gateway_tls",
        "desktop_browser",
        "mobile_browser",
        "positive_path",
        "spoof_rejection",
        "internal_surfaces_hidden",
        "rate_limit"
      ],
      "properties": {
        "policy_default_disabled": {"const": true},
        "gateway_tls": {"const": "passed"},
        "desktop_browser": {"const": "passed"},
        "mobile_browser": {"const": "passed"},
        "positive_path": {"const": "passed"},
        "spoof_rejection": {"const": "passed"},
        "internal_surfaces_hidden": {"const": "passed"},
        "rate_limit": {"const": "passed"}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ad_mutations", "dns_mutations", "dhcp_mutations", "gpo_mutations", "automatic_failover", "secret_scan"],
      "properties": {
        "ad_mutations": {"const": 0},
        "dns_mutations": {"const": 0},
        "dhcp_mutations": {"const": 0},
        "gpo_mutations": {"const": 0},
        "automatic_failover": {"const": false},
        "secret_scan": {"const": "passed"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "artifact_sha256"],
      "properties": {
        "version": {"const": "0.9.0"},
        "revision": {"$ref": "#/$defs/revision"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "predecessorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "artifact_sha256"],
      "properties": {
        "version": {"const": "0.8.0"},
        "revision": {"$ref": "#/$defs/revision"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "pkiIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ca_sha256", "certificate_sha256", "public_key_sha256"],
      "properties": {
        "ca_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "public_key_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_sha256", "manifest_sha256", "verified", "restore_verified"],
      "properties": {
        "archive_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "verified": {"const": true},
        "restore_verified": {"const": true}
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness", "peer_mtls", "drs_replication"],
      "properties": {
        "readiness": {"const": "passed"},
        "peer_mtls": {"const": "passed"},
        "drs_replication": {"const": "passed"}
      }
    },
    "rolloutBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "node",
        "status",
        "observed_candidate",
        "backup",
        "health",
        "web_identity_before",
        "web_identity_after",
        "peer_identity_before",
        "peer_identity_after"
      ],
      "properties": {
        "sequence": {"type": "integer"},
        "node": {"type": "string"},
        "status": {"const": "passed"},
        "observed_candidate": {"$ref": "#/$defs/candidateIdentity"},
        "backup": {"$ref": "#/$defs/backup"},
        "health": {"$ref": "#/$defs/health"},
        "web_identity_before": {"$ref": "#/$defs/pkiIdentity"},
        "web_identity_after": {"$ref": "#/$defs/pkiIdentity"},
        "peer_identity_before": {"$ref": "#/$defs/pkiIdentity"},
        "peer_identity_after": {"$ref": "#/$defs/pkiIdentity"}
      }
    },
    "dc02Rollout": {
      "allOf": [
        {"$ref": "#/$defs/rolloutBase"},
        {"properties": {"sequence": {"const": 1}, "node": {"const": "dc02"}}}
      ]
    },
    "dc01Rollout": {
      "allOf": [
        {"$ref": "#/$defs/rolloutBase"},
        {"properties": {"sequence": {"const": 2}, "node": {"const": "dc01"}}}
      ]
    },
    "restoreBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "observed_predecessor"],
      "properties": {
        "node": {"type": "string"},
        "observed_predecessor": {"$ref": "#/$defs/predecessorIdentity"}
      }
    },
    "dc01Restore": {
      "allOf": [
        {"$ref": "#/$defs/restoreBase"},
        {"properties": {"node": {"const": "dc01"}}}
      ]
    },
    "dc02Restore": {
      "allOf": [
        {"$ref": "#/$defs/restoreBase"},
        {"properties": {"node": {"const": "dc02"}}}
      ]
    }
  }
}
