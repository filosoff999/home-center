{
  "openapi": "3.1.0",
  "info": {
    "title": "Home Center module supply-chain planning API",
    "version": "0.11.0"
  },
  "paths": {
    "/api/v1/modules/permission-review": {
      "get": {
        "summary": "Read the current permission-review status",
        "security": [{"sessionCookie": []}],
        "responses": {
          "200": {
            "description": "No persisted review exists in this increment",
            "content": {
              "application/json": {
                "schema": {"$ref": "../modules/module-permission-review-status.v1.schema.json"}
              }
            }
          },
          "401": {"description": "Authentication required"}
        }
      }
    },
    "/api/v1/modules/permission-review/preview": {
      "post": {
        "summary": "Build a side-effect-free permission preview",
        "security": [{"sessionCookie": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "../modules/module-admission-request.v1.schema.json"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deterministic permission review; no grant or decision is persisted",
            "content": {
              "application/json": {
                "schema": {"$ref": "../modules/module-permission-review.v1.schema.json"}
              }
            }
          },
          "400": {"description": "Admission or review rejected"},
          "401": {"description": "Authentication required"},
          "403": {"description": "Cross-origin request rejected"}
        }
      }
    },
    "/api/v1/modules/permission-review/acknowledgements": {
      "get": {
        "summary": "List recent permission acknowledgements for the authenticated actor",
        "security": [{"sessionCookie": []}],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 20}
          }
        ],
        "responses": {
          "200": {
            "description": "Actor-scoped acknowledgement history",
            "content": {
              "application/json": {
                "schema": {"$ref": "../modules/module-permission-acknowledgement-list.v1.schema.json"}
              }
            }
          },
          "401": {"description": "Authentication required"}
        }
      },
      "post": {
        "summary": "Persist an expiring acknowledgement of an exact recomputed review",
        "security": [{"sessionCookie": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "../modules/module-permission-acknowledgement-request.v1.schema.json"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay",
            "content": {
              "application/json": {
                "schema": {"$ref": "../modules/module-permission-acknowledgement-result.v1.schema.json"}
              }
            }
          },
          "201": {
            "description": "Acknowledgement recorded without authorization or execution authority",
            "content": {
              "application/json": {
                "schema": {"$ref": "../modules/module-permission-acknowledgement-result.v1.schema.json"}
              }
            }
          },
          "400": {"description": "Request or exact review binding rejected"},
          "401": {"description": "Authentication required"},
          "403": {"description": "Cross-origin request rejected"},
          "409": {"description": "Idempotency-key conflict"}
        }
      }
    },
    "/api/v1/modules/permission-review/acknowledgements/{acknowledgement_id}": {
      "get": {
        "summary": "Read one acknowledgement owned by the authenticated actor",
        "security": [{"sessionCookie": []}],
        "parameters": [
          {
            "name": "acknowledgement_id",
            "in": "path",
            "required": true,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "responses": {
          "200": {
            "description": "Exact acknowledgement record",
            "content": {
              "application/json": {
                "schema": {"$ref": "../modules/module-permission-acknowledgement.v1.schema.json"}
              }
            }
          },
          "401": {"description": "Authentication required"},
          "404": {"description": "Missing, invalid or owned by another actor"}
        }
      }
    },
    "/api/v1/modules/lifecycle": {
      "get": {
        "summary": "Read the current module lifecycle status",
        "security": [{"sessionCookie": []}],
        "responses": {
          "200": {
            "description": "No persisted lifecycle exists in this increment",
            "content": {
              "application/json": {
                "schema": {"$ref": "../modules/module-lifecycle-status.v1.schema.json"}
              }
            }
          },
          "401": {"description": "Authentication required"}
        }
      }
    },
    "/api/v1/modules/lifecycle/preview": {
      "post": {
        "summary": "Build a blocked, side-effect-free module install lifecycle plan",
        "security": [{"sessionCookie": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "../modules/module-install-lifecycle-request.v1.schema.json"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deterministic blocked plan with preflight and reverse recovery",
            "content": {
              "application/json": {
                "schema": {"$ref": "../modules/module-install-lifecycle-plan.v1.schema.json"}
              }
            }
          },
          "400": {"description": "Request, acknowledgement or exact binding rejected"},
          "401": {"description": "Authentication required"},
          "403": {"description": "Cross-origin request rejected"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-home_center_session"
      }
    }
  }
}
