{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/intents/placement.v1.schema.json",
  "title": "Placement v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "strategy",
    "node_ids",
    "high_availability",
    "resource_snapshot_schema",
    "reservation_created",
    "production_mutation_enabled"
  ],
  "properties": {
    "schema": {"const": "home-center.placement.v1"},
    "strategy": {"enum": ["storage-headroom-v1", "balanced-headroom-v1"]},
    "node_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 64}
    },
    "high_availability": {"type": "boolean"},
    "resource_snapshot_schema": {"const": "home-center.resource-snapshot.v1"},
    "reservation_created": {"const": false},
    "production_mutation_enabled": {"const": false}
  }
}
