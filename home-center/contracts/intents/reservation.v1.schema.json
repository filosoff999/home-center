{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/intents/reservation.v1.schema.json",
  "title": "Home Center reservation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "reservation_id",
    "request_binding_sha256",
    "resource_snapshot_sha256",
    "intent_id",
    "idempotency_key",
    "node_ids",
    "claims",
    "state",
    "created_at_epoch",
    "expires_at_epoch",
    "lease_seconds",
    "durable",
    "provider_execution_enabled",
    "production_mutation_enabled"
  ],
  "properties": {
    "schema": {"const": "home-center.reservation.v1"},
    "reservation_id": {"$ref": "#/$defs/digest"},
    "request_binding_sha256": {"$ref": "#/$defs/digest"},
    "resource_snapshot_sha256": {"$ref": "#/$defs/digest"},
    "intent_id": {"type": "string", "format": "uuid"},
    "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 128},
    "node_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 64}
    },
    "claims": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "additionalProperties": {"$ref": "#/$defs/claim"}
    },
    "state": {"const": "reserved"},
    "created_at_epoch": {"type": "integer", "minimum": 1},
    "expires_at_epoch": {"type": "integer", "minimum": 1},
    "lease_seconds": {"type": "integer", "minimum": 5, "maximum": 900},
    "durable": {"const": false},
    "provider_execution_enabled": {"const": false},
    "production_mutation_enabled": {"const": false}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory_bytes", "storage_bytes"],
      "properties": {
        "cpu": {"type": "integer", "minimum": 0},
        "memory_bytes": {"type": "integer", "minimum": 0},
        "storage_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
