{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/helper/helper-secret-result.v1.schema.json",
  "title": "Home Center privileged helper secret-operation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "action", "status", "reason", "completed_at"],
  "properties": {
    "schema": {"const": "home-center.helper.secret-result.v1"},
    "request_id": {"type": "string", "minLength": 8, "maxLength": 96, "pattern": "^[A-Za-z0-9._-]+$"},
    "action": {"enum": ["local-admin.password.rotate.v1", "local-admin.password.validate.v1"]},
    "status": {"enum": ["succeeded", "rejected", "failed"]},
    "reason": {"type": ["string", "null"]},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
