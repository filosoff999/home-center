{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/modules/module-lifecycle-authorization.v1.schema.json",
  "title": "Home Center module lifecycle authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "plan_id",
    "actor_binding_sha256",
    "acknowledgement_id",
    "review_id",
    "scope_id",
    "publication_ids",
    "decision",
    "remaining_blockers",
    "acknowledgement_consumed",
    "lifecycle_persistence_enabled",
    "lifecycle_execution_enabled",
    "production_activation_enabled",
    "authorization_id"
  ],
  "properties": {
    "schema": {"const": "home-center.module-lifecycle-authorization.v1"},
    "plan_id": {"$ref": "#/$defs/digest"},
    "actor_binding_sha256": {"$ref": "#/$defs/digest"},
    "acknowledgement_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "review_id": {"$ref": "#/$defs/digest"},
    "scope_id": {"$ref": "#/$defs/digest"},
    "publication_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/digest"}
    },
    "decision": {"const": "authorized"},
    "remaining_blockers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"const": "lifecycle_executor_unavailable"},
        {"const": "placement_unresolved"}
      ],
      "items": false
    },
    "acknowledgement_consumed": {"const": false},
    "lifecycle_persistence_enabled": {"const": false},
    "lifecycle_execution_enabled": {"const": false},
    "production_activation_enabled": {"const": false},
    "authorization_id": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
