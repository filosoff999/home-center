{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/modules/module-admission-request.v1.schema.json",
  "title": "Home Center module admission request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "environment", "installed_modules", "candidates", "requested_modules"],
  "properties": {
    "schema": {"const": "home-center.module-admission-request.v1"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home_center_version", "architecture", "operating_system", "capabilities"],
      "properties": {
        "home_center_version": {"$ref": "#/$defs/semver"},
        "architecture": {"$ref": "#/$defs/symbolicId"},
        "operating_system": {"$ref": "#/$defs/symbolicId"},
        "capabilities": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/symbolicId"}
        }
      }
    },
    "installed_modules": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/installedModule"}
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "module-manifest.v2.schema.json"}
    },
    "requested_modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/moduleVersion"}
    }
  },
  "$defs": {
    "moduleId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,126}[a-z0-9])?$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "symbolicId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "moduleVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/moduleId"},
        "version": {"$ref": "#/$defs/semver"}
      }
    },
    "installedModule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "conflicts"],
      "properties": {
        "id": {"$ref": "#/$defs/moduleId"},
        "version": {"$ref": "#/$defs/semver"},
        "conflicts": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/moduleId"}
        }
      }
    }
  }
}
