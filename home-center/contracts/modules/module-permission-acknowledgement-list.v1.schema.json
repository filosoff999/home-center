{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/modules/module-permission-acknowledgement-list.v1.schema.json",
  "title": "Home Center module permission acknowledgement list v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "items",
    "acknowledgement_persistence_enabled",
    "authorization_decisions_enabled",
    "permission_grants_applied",
    "lifecycle_execution_enabled",
    "production_activation_enabled"
  ],
  "properties": {
    "schema": {"const": "home-center.module-permission-acknowledgement-list.v1"},
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "module-permission-acknowledgement.v1.schema.json"}
    },
    "acknowledgement_persistence_enabled": {"const": true},
    "authorization_decisions_enabled": {"const": false},
    "permission_grants_applied": {"const": false},
    "lifecycle_execution_enabled": {"const": false},
    "production_activation_enabled": {"const": false}
  }
}
