{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/auth/local-admin-password-change-result.v2.schema.json",
  "title": "Home Center two-node local administrator password change result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "transaction_id", "nodes", "commit_order", "canary_attempts"],
  "properties": {
    "schema": {"const": "home-center.local-admin-password-change-result.v2"},
    "status": {"const": "changed"},
    "transaction_id": {"type": "string", "pattern": "^la-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{16}$"},
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"}
    },
    "commit_order": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"}
    },
    "canary_attempts": {"type": "integer", "minimum": 2, "maximum": 5}
  }
}
