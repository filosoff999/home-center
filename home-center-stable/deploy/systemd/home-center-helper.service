[Unit]
Description=Home Center bounded helper
Documentation=https://github.com/ControlCenterSoft/home-center-stable
After=local-fs.target
Before=home-center.service

[Service]
Type=simple
User=root
Group=home-center
ExecStart=/usr/bin/python3 -I /opt/home-center/current/home_center/privileged_helper.py --serve
Restart=on-failure
RestartSec=2s
RuntimeDirectory=home-center-helper
RuntimeDirectoryMode=0750
StateDirectory=home-center-helper
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/etc/home-center/secrets
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
