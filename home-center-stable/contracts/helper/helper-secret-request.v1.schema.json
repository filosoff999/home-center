{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/helper/helper-secret-request.v1.schema.json",
  "title": "Home Center non-persisted privileged helper secret request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "action", "params", "nonce"],
  "properties": {
    "schema": {"const": "home-center.helper.secret-request.v1"},
    "request_id": {"type": "string", "minLength": 8, "maxLength": 96, "pattern": "^[A-Za-z0-9._-]+$"},
    "action": {"const": "local-admin.password.rotate.v1"},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["username", "current_password", "new_password"],
      "properties": {
        "username": {"const": "admin"},
        "current_password": {"type": "string", "minLength": 1, "maxLength": 256},
        "new_password": {"type": "string", "minLength": 8, "maxLength": 256}
      }
    },
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  }
}
