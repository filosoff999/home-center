{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://home-center.local/contracts/deployment-profiles/deployment-profile.v1.schema.json",
  "title": "DeploymentProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "metadata", "spec"],
  "properties": {
    "schema": {"const": "home-center.deployment-profile.v1"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "environment", "description"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "environment": {"enum": ["development", "staging", "production"]}, "description": {"type": "string"}}
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["cluster_id", "domain", "nodes", "network", "placement", "health", "backup", "maintenance"],
      "properties": {
        "cluster_id": {"type": "string", "minLength": 3},
        "domain": {"type": "object"},
        "nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/node"}},
        "network": {"type": "object"},
        "placement": {"type": "object"},
        "health": {"type": "object"},
        "backup": {"type": "object"},
        "maintenance": {"type": "object"}
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "management_address", "roles", "required_capabilities"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "management_address": {"type": "string", "format": "ipv4"},
        "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "required_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
